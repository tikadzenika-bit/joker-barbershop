{
  "name": "joker-barbershop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JOKER Barbershop · ჯოკერი — საიტი + ადმინ პანელი (Vite + TypeScript + Supabase)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
