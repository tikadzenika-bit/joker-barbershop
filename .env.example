# ── JOKER Barbershop: გარემოს ცვლადები ──────────────────────────────────────────
# დააკოპირე ეს ფაილი როგორც ".env" და შეავსე.

# საიტის საჯარო მისამართი (canonical, Open Graph, sitemap). ბოლოში "/" არ უნდა.
VITE_SITE_URL=https://example.com

# Supabase. სანამ ეს ორი ცარიელია, საიტი მუშაობს „დემო რეჟიმში" (seed.json + localStorage).
# Supabase → Project Settings → API:  Project URL  და  anon public key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# მხოლოდ GitHub Pages-ზე ქვესაქაღალდეში გასაშვებად, მაგ. /joker/
# VITE_BASE=/
